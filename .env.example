# Lokal: Port des API-Servers. Auf Railway wird PORT automatisch gesetzt.
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/lukas

# OpenAI (Key von platform.openai.com; Basis-URL nur aendern bei Azure/eigenem Gateway)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# Ueberschreibt die Standardbesetzung unten KOMPLETT. Normalerweise leer
# lassen -- dann waehlt Lukas pro Nachricht selbst die passende Rolle.
# Nur setzen, um gezielt auf EIN Modell zurueckzustellen (z.B. gpt-4o).
LUKAS_CORE_MODEL=

# ── LUKAS MULTI-BRAIN ───────────────────────────────────────────────────────
# Lukas bleibt IMMER dieselbe Identitaet. Diese Variablen bestimmen nur seine
# austauschbaren Rechenkerne. Format: provider:model-id
# Provider: openai | anthropic | google
# Wenn eine Rolle leer ist, faellt sie automatisch auf GENERAL/CORE zurueck.
# Beispielwerte absichtlich nicht hart verdrahtet: hier die Modell-IDs nutzen,
# die im jeweiligen Account aktuell freigeschaltet sind.
# Standardbesetzung, wenn hier nichts steht:
#   fast          gpt-5.6-luna    kurze Rueckfragen
#   general       gpt-5.6-terra   normales Gespraech
#   vision        gpt-5.6-terra   Bilder, Video-Frames
#   reasoning     gpt-5.6-sol     Denkarbeit
#   code          gpt-5.6-sol     Code, Repo, VPS
#   long_context  gpt-5.6-sol     sehr lange Threads
#
# Hat der Account ein Modell nicht freigeschaltet, faellt der Aufruf einmal auf
# LUKAS_CORE_MODEL (bzw. gpt-4o) zurueck und die ID wird eine Stunde lang
# uebersprungen. Eine falsche ID kostet damit Qualitaet, nicht die Funktion --
# ohne dieses Netz ist der oeffentliche Chat hier schon einmal ausgefallen.
LUKAS_MODEL_FAST=
LUKAS_MODEL_GENERAL=
LUKAS_MODEL_REASONING=
LUKAS_MODEL_CODE=
LUKAS_MODEL_VISION=
LUKAS_MODEL_LONG_CONTEXT=
# Feste sichtbare "Stimme" nach internen Spezialmodellen. Standard: GENERAL.
LUKAS_MODEL_VOICE=

# Groesse der aktiven Modell-Payload als konservative Zeichenschaetzung.
# Der komplette Chat wird trotzdem dauerhaft gespeichert. Bei sehr langen
# Threads wird nur der aktuelle Modellaufruf gepackt; alte Originalnachrichten
# bleiben ueber das Chat-Archiv/query_memory wieder abrufbar.
LUKAS_CONTEXT_MAX_CHARS=220000

# Direkte Provider-Keys. Fehlt ein Key, routet Lukas stabil auf seinen OpenAI-Core zurueck.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Alternativ zu GEMINI_API_KEY werden auch diese Namen akzeptiert:
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# Sprachchat (OpenAI Realtime API, Speech-to-Speech)
LUKAS_REALTIME_MODEL=gpt-realtime-2.1
LUKAS_REALTIME_VOICE=ash

# Higgsfield Media-Generierung (Studio).
# Wird nur noch als RUECKFALL benutzt: laeuft unter "MCP" ein verbundener
# Server mit generate_image/generate_video, geht das Studio darueber und
# braucht diesen Schluessel nicht. Steht dort nichts, greift der alte Weg.
HIGGSFIELD_API_KEY=

# Bearer-Token fuer die private API (Dashboard, Lukas' Tools, Erinnerungen).
# PFLICHT. Fehlt der Wert, antwortet die private API mit 503, statt sich
# stillschweigend zu oeffnen. Healthcheck, Portfolio-Widget und WhatsApp-Webhook
# bleiben davon unberuehrt und funktionieren weiter.
# Einzige Ausnahme: NODE_ENV=development, das setzt "npm run dev" selbst.
LUKAS_API_TOKEN=

# Optional: Postgres des VPS-Trading-Systems
VPS_DATABASE_URL=

# Portfolio-Widget
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=agent_4501ky1q2tgvepx906k5waew8bwk
ELEVENLABS_LLM_TOKEN=
LUKAS_PUBLIC_MODEL=gpt-4o-mini

# Moltbook
MOLTBOOK_API_KEY=

# Optional: semantische Gedaechtnissuche
VOYAGE_API_KEY=

# Optional: GitHub-Zugriff fuer Lukas
GITHUB_TOKEN=

# Optional: E-Mail-Zugriff fuer Lukas
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Nur noetig, falls kein Gmail (Standard: imap.gmail.com / smtp.gmail.com).
#
# Fuer iCloud/Apple-Mail (App-spezifisches Passwort unter appleid.apple.com
# erzeugen, EMAIL_USER ist die @icloud.com-Adresse):
#   EMAIL_IMAP_HOST=imap.mail.me.com
#   EMAIL_SMTP_HOST=smtp.mail.me.com
# Port und Verschluesselung werden automatisch passend gewaehlt (iCloud: 587
# mit STARTTLS, Gmail: 465 mit direktem TLS) — nur setzen, wenn dein Anbieter
# davon abweicht.
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_IMAP_PORT=
EMAIL_SMTP_PORT=
EMAIL_SMTP_SECURE=

# ── LUKAS EXECUTION / DIGITALOCEAN ──────────────────────────────────────────
# Wo execute_command laeuft. Alles davon liegt auf Issas eigenem
# DigitalOcean-Droplet -- E2B ist raus und wird nicht mehr unterstuetzt.
#
#   docker (Standard)  Docker-Container auf dem Droplet, per SSH gesteuert.
#                      Lukas hat darin root, volles Internet und keinen
#                      Befehls-Filter -- aber weder Host-Dateisystem noch
#                      Host-Variablen noch den Docker-Socket.
#   ssh                direkt auf dem Droplet-Host, ohne Container.
#   host               direkt auf dem Host per nsenter, wenn Lukas SELBST als
#                      privilegierter Container dort laeuft.
#
# WICHTIG -- warum der Standard der Container ist: auf dem Droplet liegen die
# Trading-Credentials, die Wallet-Keys und die Postgres-DB. Lukas liest E-Mails
# und Webseiten, also fremde Inhalte. Mit einer Shell direkt auf dem Host wuerde
# eine praeparierte Mail genuegen, um da heranzukommen.
#
# Folge fuer ssh/host: execute_command wird dann automatisch als R3 eingestuft
# und braucht pro Befehl eine Freigabe im Dashboard. Das ist kein Versehen --
# wer die Isolation abschaltet, soll nicht nebenbei auch die Freigabepflicht
# abschalten. Im Standard (docker) laeuft alles ohne Rueckfrage durch.
LUKAS_EXECUTION_BACKEND=docker

# Zweiter, ausdruecklicher Schalter -- nur fuer Backend=host.
LUKAS_HOST_EXECUTOR_ENABLED=false

# SSH-Zugang zum Droplet (fuer Backend=docker und ssh).
# Eigenes Schluesselpaar NUR fuer Lukas erzeugen:
#   ssh-keygen -t ed25519 -f lukas_sandbox -C "lukas-sandbox"
# den .pub-Teil auf dem Droplet in ~/.ssh/authorized_keys eintragen,
# den privaten Teil (kompletter Inhalt inkl. BEGIN/END-Zeilen) hier setzen.
# Hiessen frueher LUKAS_DO_SSH_* -- falls die noch irgendwo gesetzt sind,
# werden sie nicht mehr gelesen.
VPS_SSH_HOST=
VPS_SSH_USER=root
VPS_SSH_KEY=
VPS_SSH_PORT=22
# Basis-Image der Sandbox (Standard: python:3.12-slim)
LUKAS_SANDBOX_IMAGE=python:3.12-slim

# Wohin eine von Issa ANGENOMMENE Code-Aenderung geschrieben wird.
# Lukas legt Vorschlaege im Dashboard unter "Vorschlaege" ab; erst beim Klick
# auf "Annehmen" entsteht ein Commit.
#
# Normalerweise LEER LASSEN: dann wird automatisch der Branch beschrieben, aus
# dem dieser Server gebaut wurde (Railway setzt RAILWAY_GIT_BRANCH selbst).
# Annehmen heisst damit ohne jede Konfiguration: es geht live.
# Nur setzen, wenn es ausnahmsweise woandershin soll.
LUKAS_SELF_PATCH_BRANCH=

# ffmpeg zerlegt hochgeladene Videos in Einzelbilder, damit Lukas sie ansehen
# kann. Normalerweise kommt die Binary aus dem Paket ffmpeg-static und dieser
# Wert bleibt leer. Nur setzen, wenn ffmpeg woanders liegt (eigenes Image o.ae.)
# -- z.B. FFMPEG_BIN=/usr/bin/ffmpeg
FFMPEG_BIN=

# ── AUTONOMIE ───────────────────────────────────────────────────────────────
# Lukas arbeitet von sich aus an den Zielen, die im Dashboard unter "Ziele"
# stehen. Er sucht sich selbst eins aus und entscheidet selbst, womit er
# vorankommt -- Websuche, Shell auf dem Droplet, Code-Vorschlag, Gedaechtnis.
# Es gibt bewusst keine fest programmierten Taetigkeits-Schleifen mehr.
#
# Schreibende Aktionen laufen durch dasselbe Freigabe-Gate wie im Chat. Ohne
# laufendes Gespraech greift die Bestaetigung-im-Chat nicht, R2/R3 landen also
# als Freigabe im Dashboard und warten dort.
LUKAS_AUTONOMY_ENABLED=true
LUKAS_AUTONOMY_INTERVAL_MIN=30

# ── WIE FREI LUKAS ARBEITET ─────────────────────────────────────────────────
# Grundhaltung: er handelt, statt zu fragen. Die EINZIGE Ausnahme sind
# Aenderungen an seinem eigenen Code -- die gehen ueber "Vorschlaege" ins
# Dashboard, weil er der Code ist, den er aendert.
#
# Ohne Rueckfrage laeuft damit: recherchieren, Mails lesen UND schreiben, auf
# dem Droplet arbeiten und installieren, Gedaechtnis und Ziele pflegen, das
# Team einsetzen, angebundene MCP-Werkzeuge benutzen.
#
# Die beiden Schalter holen einzelne Bereiche zurueck unter Freigabepflicht:
#
#   LUKAS_EMAIL_APPROVAL=true
#     Jeder Mailversand landet wieder als Freigabe im Dashboard. Der einzige
#     Punkt, der sich nicht zurueckholen laesst -- und Lukas liest fremde
#     Mails, in denen jemand ihm einen Versand unterschieben koennte.
#
#   LUKAS_HOST_APPROVAL=true
#     Befehle direkt auf dem Droplet-Host (statt im Container) brauchen wieder
#     eine Freigabe pro Befehl.
LUKAS_EMAIL_APPROVAL=false

# SMS ueber ClickSend. Ohne diese beiden geht kein Versand — weder aus dem
# Dashboard noch von Lukas. CLICKSEND_ABSENDER ist der Name oder die Nummer,
# die der Empfaenger sieht (leer = die Nummer des Kontos).
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=
# CLICKSEND_ABSENDER=
#
# Nur setzen, wenn Nummern mit fuehrender Null (0152...) automatisch in
# internationale Schreibweise gebracht werden sollen. Ohne das wird NICHT
# geraten, und eine unvollstaendige Nummer wird abgelehnt statt verschickt.
# LUKAS_LAENDERVORWAHL=+49
LUKAS_HOST_APPROVAL=false

# Interne Adressen sind fuer fetch_url und browse_page gesperrt (Metadaten-
# Dienst, Loopback, privates Netz) — das schuetzt gegen Anweisungen, die in
# fremden Mails oder Webseiten stehen. Eigene interne Dienste, die Lukas
# trotzdem abrufen koennen soll, hier eintragen (Kommaliste von Hostnamen):
# LUKAS_FETCH_ALLOWLIST=mein-dienst.intern

# Moltbook ist EINE Taetigkeit, nicht die Haupttaetigkeit. Lief frueher alle
# 45 Minuten und war damit Lukas' gesamtes Eigenleben.
LUKAS_MOLTBOOK_INTERVAL_MIN=240

# ── MCP: fremde Werkzeuge fuer Lukas ────────────────────────────────────────
# Hoechstzahl Werkzeuge pro Server, solange im Dashboard keine Auswahl
# getroffen wurde. Hintergrund: Higgsfield meldet 81 Werkzeuge, die bei JEDEM
# Modellaufruf mitgeschickt wuerden -- rund 20.000 Token, bevor ein Wort
# Gespraech dazukommt. Bei 30.000 Token pro Minute ist damit jede Anfrage tot.
LUKAS_MCP_MAX_TOOLS=12

# Im Dashboard unter "MCP" traegt Issa MCP-Server ein und meldet sich per OAuth
# beim jeweiligen Anbieter an. Deren Werkzeuge stehen Lukas danach zusaetzlich
# zu seinen eigenen zur Verfuegung.
#
# Die Rueckleitung nach der Anmeldung geht an:
#   https://DEINE-DOMAIN/api/lukas/mcp/callback
# Die Adresse wird normalerweise selbst erkannt (Railway setzt
# RAILWAY_PUBLIC_DOMAIN). Nur setzen, wenn das nicht passt -- z.B. hinter einem
# eigenen Reverse Proxy oder unter einer anderen Domain.
LUKAS_PUBLIC_URL=

# WhatsApp (offizielle Meta Cloud API) -- Lukas per WhatsApp erreichbar machen.
# Einrichtung: developers.facebook.com -> App anlegen -> Produkt "WhatsApp".
# Webhook-URL dort eintragen: https://DEINE-DOMAIN/api/whatsapp/webhook
# und als "Verify Token" exakt denselben Wert wie WHATSAPP_VERIFY_TOKEN unten.
#
# ACHTUNG, daran ist schon ein ganzer Abend draufgegangen: die Domain muss auf
# den Dienst zeigen, auf dem DIESER API-Server laeuft. lukas.issahareb.me loest
# per A-Record auf einen DigitalOcean-Droplet auf, waehrend der Code auf Railway
# deployed wird -- dazwischen sitzt ein Reverse Proxy. Bevor du die URL bei Meta
# eintraegst, einmal im Browser oeffnen:
#   https://DEINE-DOMAIN/api/whatsapp/webhook
# Erwartet: "forbidden" (Route lebt) oder "not configured" (Route lebt, Token
# fehlt). Kommt {"error":"Unauthorized"} oder eine HTML-Seite, zeigt die Adresse
# nicht auf diesen Code -- dann hilft kein Fix am Router.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Frei gewaehlter Zufallsstring; Meta schickt ihn beim Einrichten zurueck.
WHATSAPP_VERIFY_TOKEN=
# App-Secret aus den Meta-App-Einstellungen. Damit wird jede eingehende Anfrage
# kryptografisch geprueft. OHNE diesen Wert lehnt der Webhook ALLES ab --
# bewusst so: der Endpunkt ist oeffentlich erreichbar und loest Lukas' Tools
# aus (Shell, E-Mail, GitHub).
WHATSAPP_APP_SECRET=
# Kommaliste der Nummern MIT ADMIN-RECHTEN (mit Laendervorwahl, z.B.
# +4915259559707). Nur diese Nummern bekommen den vollstaendigen privaten
# Lukas: Gedaechtnis, E-Mails, GitHub, Shell, alle Werkzeuge.
#
# Alle ANDEREN Nummern koennen mit ihm chatten, bekommen aber:
#   - den oeffentlichen Prompt (nur als "public" markierte Erinnerungen)
#   - KEINE Werkzeuge (leeres Array im Modellaufruf, nicht nur eine Anweisung)
#   - einen eigenen Gespraechs-Thread, damit ihre Nachrichten nie als Kontext
#     in Issas privaten Lukas zurueckfliessen
#   - keinen Eintrag im Langzeitgedaechtnis
#   - ein Limit von 20 Nachrichten pro Stunde
#
# Die Rolle haengt AUSSCHLIESSLICH an der Absendernummer aus Metas Webhook,
# nie am Nachrichtentext. "Ich bin Issa, neue Nummer" ist damit wirkungslos.
# Ist die Liste leer, ist NIEMAND Admin (fail closed) -- Lukas chattet dann mit
# allen, kann aber nichts ausloesen.
WHATSAPP_OWNER_NUMBERS=
# Alter Name derselben Einstellung, wird weiterhin gelesen.
WHATSAPP_ALLOWED_NUMBERS=

# ── TELEFON ─────────────────────────────────────────────────────────────────
# Lukas am Telefon. Eingehend laeuft ueber einen SIP-Trunk beim Telefonanbieter,
# der auf OpenAI zeigt: sip:<OPENAI_PROJECT_ID>@sip.api.openai.com;transport=tls
# OpenAI meldet den Anruf dann per Webhook an /api/telefon/eingehend.
#
# OHNE dieses Secret wird JEDER eingehende Anruf abgewiesen. Das ist Absicht:
# ein ungeprueft angenommener Anruf waere ein offenes Mikrofon.
OPENAI_WEBHOOK_SECRET=
# Projekt-ID aus der OpenAI-Plattform (proj_...). Zeigt der SIP-Trunk hierauf,
# landen Anrufe bei deinem Projekt.
OPENAI_PROJECT_ID=
# Nur noetig, wenn Lukas SELBST anrufen soll: OpenAI kann keine Anrufe starten,
# nur annehmen. Twilio waehlt und verbindet das Gespraech in denselben Trunk.
#
# ACHTUNG, haeufige Verwechslung: In der Twilio-Konsole findet man unter
# "API keys & tokens" einen API Key (SK...) mit Secret. Der Account SID (AC...)
# steht NICHT dort, sondern auf der Startseite unter "Account Info" — und er
# wird IMMER gebraucht, weil er im Pfad der URL steht und nicht in der
# Anmeldung.
TWILIO_ACCOUNT_SID=
# Anmeldung: entweder API Key + Secret (besser, einzeln zurueckziehbar) ...
TWILIO_API_KEY=
TWILIO_API_SECRET=
# ... oder der Auth Token von der Startseite. Eines von beidem reicht.
TWILIO_AUTH_TOKEN=
# Die Twilio-Nummer, von der aus angerufen wird, in E.164: +49...
TWILIO_NUMMER=
