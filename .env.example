# Lokal: Port des API-Servers. Auf Railway wird PORT automatisch gesetzt.
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/lukas

# OpenAI (Key von platform.openai.com; Basis-URL nur aendern bei Azure/eigenem Gateway)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# Modell fuer Lukas' "Gehirn" (Chat, Reflexion, Moltbook, Higgsfield-Prompts).
# ACHTUNG: "gpt-5.6-sol" (aus SDK-Typdefinition + Websuche, nie live gegen die
# echte API verifiziert) hat den oeffentlichen Chat lahmgelegt -- vermutlich
# ungueltige/nicht verfuegbare Modell-ID fuer diesen Account. Zurueckgesetzt
# auf den bekannt funktionierenden Standard, bis die echte verfuegbare
# Modell-Liste geprueft ist (z.B. ueber die OpenAI-Konsole/Billing-Seite).
LUKAS_CORE_MODEL=gpt-4o

# Sprachchat (OpenAI Realtime API, Speech-to-Speech, ~200-300ms Latenz) --
# fuer BEIDE Kanaele: privater Dashboard-Chat UND oeffentliches Portfolio-Widget.
# Nutzt denselben AI_INTEGRATIONS_OPENAI_API_KEY. Kein separater Key noetig.
LUKAS_REALTIME_MODEL=gpt-realtime-2.1
# Stimme: ash = neutrale maennliche Stimme (Standard, auf Issas Wunsch).
# cedar ist ebenfalls maennlich, klang beim Testen z.T. irisch auf Deutsch.
# marin ist die (weibliche) Stimme, die vorher Standard war. Weitere: alloy,
# echo, verse, coral, shimmer, sage, ballad.
LUKAS_REALTIME_VOICE=ash

# Optional: Higgsfield Media-Generierung
HIGGSFIELD_API_KEY=

# Optional: Bearer-Token fuer die API (schuetzt alle /api-Routen ausser /api/health)
LUKAS_API_TOKEN=

# Optional: Postgres des VPS-Trading-Systems (fuer /api/trades und Lukas-Tool get_trading_stats)
VPS_DATABASE_URL=

# Portfolio-Widget (oeffentlicher Chat/Voice-Assistent, /api/public/*)
# Stimme: OpenAI Realtime (siehe LUKAS_REALTIME_MODEL/_VOICE oben), kein
# separater Key noetig. ELEVENLABS_* unten ist nur noch fuer den
# data-voice="classic"-TTS-Fallback bzw. einen optionalen ElevenLabs-Agent
# als Custom LLM -- vom Widget selbst nicht mehr fuer die Stimme benutzt.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional: ElevenLabs-Agent als Custom LLM (falls du zusaetzlich zum Widget
# einen eigenstaendigen ElevenLabs-Agent betreiben willst):
# 1. Agent in der ElevenLabs-Konsole anlegen (deutsche Stimme, Sprache Deutsch)
# 2. Dort unter LLM -> "Custom LLM": URL https://DEINE-DOMAIN/api/public/llm/v1
#    und als API-Key den ELEVENLABS_LLM_TOKEN (selbst erzeugter langer Zufallsstring)
ELEVENLABS_AGENT_ID=agent_4501ky1q2tgvepx906k5waew8bwk
ELEVENLABS_LLM_TOKEN=
# Modell fuer den oeffentlichen Widget-Text-Chat (Standard: gpt-4o-mini --
# siehe Hinweis bei LUKAS_CORE_MODEL oben, "gpt-5.6-terra" war nicht nutzbar)
LUKAS_PUBLIC_MODEL=gpt-4o-mini

# Moltbook (soziales Netzwerk der KI-Agenten) — Registrierung: npm run moltbook:register
# Danach Agent ueber die claim_url claimen und den Key hier eintragen.
# ACHTUNG: Der alte Key aus dem Agent-spy-Repo ist OEFFENTLICH und kompromittiert — rotieren!
MOLTBOOK_API_KEY=

# Optional: semantische Gedaechtnissuche (Voyage AI Embeddings; ohne Key lexikalisch)
VOYAGE_API_KEY=

# Optional: GitHub-Zugriff fuer Lukas (nur privater Dashboard-Chat, nie Widget).
# Personal Access Token (fine-grained) erzeugen: https://github.com/settings/tokens
# Berechtigung: nur "Contents: Read-only" (+ "Metadata: Read-only", wird automatisch
# mitgesetzt) fuer die gewuenschten Repos. Damit kann Lukas Repos auflisten, Dateien
# lesen und Code durchsuchen -- rein lesend, kein Schreibzugriff.
GITHUB_TOKEN=

# Optional: E-Mail-Zugriff fuer Lukas (nur privater Dashboard-Chat, nie Widget).
# Gmail-App-Passwort erzeugen (erfordert 2FA am Google-Konto):
# https://myaccount.google.com/apppasswords
# Damit kann Lukas das Postfach durchsuchen/lesen. Senden geht nur, wenn Issa
# im selben Chat-Turn ausdruecklich "senden"/"schicken" schreibt -- das wird
# serverseitig hart geprueft (siehe lib/email.ts), nicht nur per Prompt.
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Nur noetig, falls kein Gmail (Standard: imap.gmail.com / smtp.gmail.com).
#
# Fuer iCloud/Apple-Mail (App-spezifisches Passwort unter appleid.apple.com
# erzeugen, EMAIL_USER ist die @icloud.com-Adresse):
#   EMAIL_IMAP_HOST=imap.mail.me.com
#   EMAIL_SMTP_HOST=smtp.mail.me.com
# Port und Verschluesselung werden automatisch passend gewaehlt (iCloud: 587
# mit STARTTLS, Gmail: 465 mit direktem TLS) — nur setzen, wenn dein Anbieter
# davon abweicht.
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_IMAP_PORT=
EMAIL_SMTP_PORT=
EMAIL_SMTP_SECURE=

# Ausfuehrungsumgebung fuer Lukas (nur privater Dashboard-Chat): root-Rechte,
# volles Internet, kein Befehls-Filter -- Issas ausdruecklicher Wunsch. Laeuft
# als Docker-Container auf Issas eigenem DigitalOcean-Droplet (E2B wird nicht
# mehr gebraucht).
#
# WICHTIG -- warum Container und nicht direkt auf dem Droplet: dort liegen die
# Trading-Credentials, die Wallet-Keys und die Postgres-DB. Lukas liest
# E-Mails und Webseiten, also fremde Inhalte. Mit einer Shell direkt auf dem
# Host wuerde eine praeparierte Mail genuegen, um da heranzukommen. Der
# Container bekommt kein Host-Dateisystem, keine Host-Variablen und keinen
# Docker-Socket.
#
# SSH-Schluessel: eigenes Schluesselpaar NUR fuer Lukas erzeugen
#   ssh-keygen -t ed25519 -f lukas_sandbox -C "lukas-sandbox"
# den .pub-Teil auf dem Droplet in ~/.ssh/authorized_keys eintragen,
# den privaten Teil (kompletter Inhalt inkl. BEGIN/END-Zeilen) hier setzen.
VPS_SSH_HOST=
VPS_SSH_USER=root
VPS_SSH_KEY=
VPS_SSH_PORT=22
# Basis-Image der Sandbox (Standard: python:3.12-slim)
LUKAS_SANDBOX_IMAGE=python:3.12-slim

# ffmpeg zerlegt hochgeladene Videos in Einzelbilder, damit Lukas sie ansehen
# kann. Normalerweise kommt die Binary aus dem Paket ffmpeg-static und dieser
# Wert bleibt leer. Nur setzen, wenn ffmpeg woanders liegt (eigenes Image o.ae.)
# -- z.B. FFMPEG_BIN=/usr/bin/ffmpeg
FFMPEG_BIN=

# WhatsApp (offizielle Meta Cloud API) -- Lukas per WhatsApp erreichbar machen.
# Einrichtung: developers.facebook.com -> App anlegen -> Produkt "WhatsApp".
# Webhook-URL dort eintragen: https://DEINE-RAILWAY-DOMAIN/api/whatsapp/webhook
# und als "Verify Token" exakt denselben Wert wie WHATSAPP_VERIFY_TOKEN unten.
#
# ACHTUNG, hier ist schon einmal ein ganzer Abend draufgegangen:
# Die Domain MUSS auf den Railway-Service zeigen, auf dem dieser API-Server
# laeuft -- also die *.up.railway.app-Adresse aus Railway -> Settings ->
# Networking, oder eine eigene Domain, die per CNAME genau dorthin zeigt.
# lukas.issahareb.me zeigte per A-Record auf 134.209.226.122, und das ist der
# DigitalOcean-Droplet, nicht Railway. Metas Anfragen landeten also nie bei
# diesem Code -- egal wie oft der Webhook-Router hier gefixt wurde.
# Vor dem Eintragen bei Meta einmal im Browser oeffnen:
#   https://DEINE-DOMAIN/api/whatsapp/webhook
# Erwartet: "forbidden" (Route lebt) oder "not configured" (Route lebt, Token
# fehlt). Kommt {"error":"Unauthorized"} oder eine HTML-Seite, ist es die
# falsche Adresse.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Frei gewaehlter Zufallsstring; Meta schickt ihn beim Einrichten zurueck.
WHATSAPP_VERIFY_TOKEN=
# App-Secret aus den Meta-App-Einstellungen. Damit wird jede eingehende
# Anfrage kryptografisch geprueft. OHNE diesen Wert lehnt der Webhook ALLES
# ab -- bewusst so: der Endpunkt ist oeffentlich erreichbar und loest Lukas'
# Tools aus (Shell, E-Mail, GitHub).
WHATSAPP_APP_SECRET=
# Kommaliste der Nummern, denen Lukas antworten darf (mit Laendervorwahl,
# z.B. +4917012345678). PFLICHT: ist die Liste leer, antwortet er niemandem.
# Sonst koennte jeder, der die Nummer kennt, mit deinem privaten Lukas reden.
WHATSAPP_ALLOWED_NUMBERS=
