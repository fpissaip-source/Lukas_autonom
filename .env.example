# Niemals echte Schluessel in Git committen. Fuer den VPS liegt die echte Datei
# ausschliesslich als .env auf dem Server und hat Dateirechte 600.
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/lukas

# Domain fuer Caddy. Zum ersten Test ueber die Server-IP: :80
# Spaeter z.B. lukas.example.com eintragen und Docker Compose neu starten.
LUKAS_DOMAIN=:80

# Private Dashboard-API: Same-Origin ist automatisch erlaubt. Zusaetzliche
# erlaubte Browser-Urspruenge kommasepariert eintragen, ohne abschliessenden Slash.
LUKAS_ALLOWED_ORIGINS=
# Oeffentliches Portfolio-Widget darf standardmaessig eingebettet werden.
# Fuer eine feste Liste z.B. https://issahareb.me,https://www.issahareb.me
LUKAS_PUBLIC_ORIGINS=*

# Produktionsschutz. Ohne Token verweigert die private API in Produktion den Start
# von geschuetzten Aktionen. Einen langen zufaelligen Wert verwenden.
LUKAS_API_TOKEN=
LUKAS_RATE_LIMIT_PER_MINUTE=180
LUKAS_PUBLIC_RATE_LIMIT_PER_MINUTE=60
LUKAS_EXPENSIVE_RATE_LIMIT_PER_MINUTE=20
LUKAS_JSON_BODY_LIMIT=2mb
LUKAS_FORM_BODY_LIMIT=256kb

# OpenAI
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
LUKAS_CORE_MODEL=gpt-4o
LUKAS_REALTIME_MODEL=gpt-realtime-2.1
LUKAS_REALTIME_VOICE=ash
LUKAS_PUBLIC_MODEL=gpt-4o-mini

# Optional: Higgsfield Cloud API. Dieser Key nutzt das getrennte Cloud-API-Guthaben.
# Die MCP-Anbindung wird als eigener Provider integriert und benoetigt diesen Key nicht.
HIGGSFIELD_API_KEY=

# Optional: Postgres des VPS-Trading-Systems
VPS_DATABASE_URL=

# ElevenLabs / Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM_TOKEN=

# Optionale Integrationen
MOLTBOOK_API_KEY=
VOYAGE_API_KEY=
GITHUB_TOKEN=
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
E2B_API_KEY=

# Oeffentliche Portfolio-URL, falls Integrationen sie benoetigen
LUKAS_PUBLIC_PORTFOLIO_URL=
