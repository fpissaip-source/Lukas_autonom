# Lokal: Port des API-Servers. Auf Railway wird PORT automatisch gesetzt.
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/lukas

# OpenAI (Key von platform.openai.com; Basis-URL nur aendern bei Azure/eigenem Gateway)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# Modell fuer Lukas' "Gehirn" (Chat, Reflexion, Moltbook, Higgsfield-Prompts)
LUKAS_CORE_MODEL=gpt-4o

# Privater Sprachchat im Dashboard (OpenAI Realtime API, Speech-to-Speech, ~200-300ms Latenz)
# Nutzt denselben AI_INTEGRATIONS_OPENAI_API_KEY. Kein separater Key noetig.
LUKAS_REALTIME_MODEL=gpt-realtime-2.1

# Optional: Higgsfield Media-Generierung
HIGGSFIELD_API_KEY=

# Optional: Bearer-Token fuer die API (schuetzt alle /api-Routen ausser /api/health)
LUKAS_API_TOKEN=

# Optional: Postgres des VPS-Trading-Systems (fuer /api/trades und Lukas-Tool get_trading_stats)
VPS_DATABASE_URL=

# Portfolio-Widget (oeffentlicher Chat/Voice-Assistent, /api/public/*)
# Stimme: ElevenLabs (Flash v2.5 = ~75ms Latenz). Voice-ID aus deiner VoiceLab.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ElevenLabs AGENTS (Sprach-Konversation mit Sub-Sekunden-Latenz):
# 1. Agent in der ElevenLabs-Konsole anlegen (deutsche Stimme, Sprache Deutsch)
# 2. Dort unter LLM -> "Custom LLM": URL https://DEINE-DOMAIN/api/public/llm/v1
#    und als API-Key den ELEVENLABS_LLM_TOKEN (selbst erzeugter langer Zufallsstring)
# 3. Agent-ID hier eintragen (und/oder als data-agent-id im Widget)
#    Issas Agent "L.U.K.A.S.": agent_4501ky1q2tgvepx906k5waew8bwk (ID ist kein Secret)
ELEVENLABS_AGENT_ID=agent_4501ky1q2tgvepx906k5waew8bwk
ELEVENLABS_LLM_TOKEN=
# Modell fuer den oeffentlichen Widget-Chat (Standard: gpt-4o-mini = schnellste Antworten)
LUKAS_PUBLIC_MODEL=gpt-4o-mini

# Moltbook (soziales Netzwerk der KI-Agenten) — Registrierung: npm run moltbook:register
# Danach Agent ueber die claim_url claimen und den Key hier eintragen.
# ACHTUNG: Der alte Key aus dem Agent-spy-Repo ist OEFFENTLICH und kompromittiert — rotieren!
MOLTBOOK_API_KEY=

# Optional: semantische Gedaechtnissuche (Voyage AI Embeddings; ohne Key lexikalisch)
VOYAGE_API_KEY=
