# Lokal: Port des API-Servers. Auf Railway wird PORT automatisch gesetzt.
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/lukas

# OpenAI (Key von platform.openai.com; Basis-URL nur aendern bei Azure/eigenem Gateway)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
LUKAS_CORE_MODEL=gpt-4o

# ── LUKAS MULTI-BRAIN ───────────────────────────────────────────────────────
# Lukas bleibt IMMER dieselbe Identitaet. Diese Variablen bestimmen nur seine
# austauschbaren Rechenkerne. Format: provider:model-id
# Provider: openai | anthropic | google
# Wenn eine Rolle leer ist, faellt sie automatisch auf GENERAL/CORE zurueck.
# Beispielwerte absichtlich nicht hart verdrahtet: hier die Modell-IDs nutzen,
# die im jeweiligen Account aktuell freigeschaltet sind.
LUKAS_MODEL_FAST=
LUKAS_MODEL_GENERAL=
LUKAS_MODEL_REASONING=
LUKAS_MODEL_CODE=
LUKAS_MODEL_VISION=
LUKAS_MODEL_LONG_CONTEXT=
# Feste sichtbare "Stimme" nach internen Spezialmodellen. Standard: GENERAL.
LUKAS_MODEL_VOICE=

# Direkte Provider-Keys. Fehlt ein Key, routet Lukas stabil auf seinen OpenAI-Core zurueck.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Alternativ zu GEMINI_API_KEY werden auch diese Namen akzeptiert:
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# Sprachchat (OpenAI Realtime API, Speech-to-Speech)
LUKAS_REALTIME_MODEL=gpt-realtime-2.1
LUKAS_REALTIME_VOICE=ash

# Optional: Higgsfield Media-Generierung
HIGGSFIELD_API_KEY=

# Optional: Bearer-Token fuer die private API
LUKAS_API_TOKEN=

# Optional: Postgres des VPS-Trading-Systems
VPS_DATABASE_URL=

# Portfolio-Widget
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=agent_4501ky1q2tgvepx906k5waew8bwk
ELEVENLABS_LLM_TOKEN=
LUKAS_PUBLIC_MODEL=gpt-4o-mini

# Moltbook
MOLTBOOK_API_KEY=

# Optional: semantische Gedaechtnissuche
VOYAGE_API_KEY=

# Optional: GitHub-Zugriff fuer Lukas
GITHUB_TOKEN=

# Optional: E-Mail-Zugriff fuer Lukas
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=

# ── LUKAS EXECUTION / DIGITALOCEAN ──────────────────────────────────────────
# Welches System execute_command kontrolliert:
#   e2b  = isolierte Wegwerf-Sandbox
#   host = der echte Host, wenn Lukas selbst als privilegierter Container auf
#          dem DigitalOcean-Droplet laeuft (nsenter)
#   ssh  = ein entfernter DigitalOcean-Droplet per SSH
LUKAS_EXECUTION_BACKEND=e2b

# E2B, nur fuer Backend=e2b
E2B_API_KEY=

# Direkter Host-Zugriff, nur fuer Backend=host. Bewusst zweiter Schalter.
LUKAS_HOST_EXECUTOR_ENABLED=false

# DigitalOcean SSH, nur fuer Backend=ssh.
# Host kann die feste IPv4 oder ein DNS-Name des Droplets sein.
LUKAS_DO_SSH_HOST=
LUKAS_DO_SSH_PORT=22
LUKAS_DO_SSH_USER=root
# Entweder ein im Runtime-Dateisystem gemounteter Key ...
LUKAS_DO_SSH_KEY_PATH=
# ... oder der private Key als Secret. Mehrzeilig oder mit literalem \n ist erlaubt.
LUKAS_DO_SSH_PRIVATE_KEY=
# Stark empfohlen: Host-Key pinnen. Inhalt aus ~/.ssh/known_hosts oder Pfad.
LUKAS_DO_SSH_KNOWN_HOSTS=
LUKAS_DO_SSH_KNOWN_HOSTS_PATH=
# Optional, falls ssh nicht im PATH liegt.
LUKAS_SSH_BIN=ssh

# WhatsApp (offizielle Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_NUMBERS=
