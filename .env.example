PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/lukas

# Anthropic (Replit AI integration or eigener Key + Basis-URL)
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Higgsfield Media-Generierung
HIGGSFIELD_API_KEY=

# Optional: Bearer-Token fuer die API (schuetzt alle /api-Routen ausser /api/health)
LUKAS_API_TOKEN=

# Optional: Postgres des VPS-Trading-Systems (fuer /api/trades und Lukas-Tool get_trading_stats)
VPS_DATABASE_URL=

# Portfolio-Widget (oeffentlicher Chat/Voice-Assistent, /api/public/*)
# Stimme: ElevenLabs (Flash v2.5 = ~75ms Latenz). Voice-ID aus deiner VoiceLab.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Modell fuer den oeffentlichen Widget-Chat (Standard: claude-haiku-4-5 = schnellste Antworten)
LUKAS_PUBLIC_MODEL=claude-haiku-4-5
